# Supabase — 값이 비어 있으면 업로드가 mock 모드로 동작한다 (키 없이 ②단계 확인용)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 브라우저에서 직접 쓰는 값 (제출 API 붙일 때 사용)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 워커 — Notion 자동 등록
# (Google Sheets 는 v1 범위에서 제외했다. README '시트를 빼기로 한 이유' 참고)
NOTION_TOKEN=
NOTION_DATABASE_ID=

# 워커 — 접수 확인 메일 (Gmail SMTP)
# 앱 비밀번호는 2단계 인증을 켠 계정에서 myaccount.google.com/apppasswords 로 발급한다.
# 평소 로그인 비밀번호가 아니다.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# 재처리 주소(/api/worker/process) 잠금. 아무 긴 문자열이면 된다.
WORKER_SECRET=

# Vercel Analytics 는 대시보드에서 켜기만 하면 되고, 환경변수는 필요 없다.
