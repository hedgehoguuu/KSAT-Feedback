# Supabase — 값이 비어 있으면 업로드가 mock 모드로 동작한다 (키 없이 ②단계 확인용)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# anon 키는 쓰지 않는다. 브라우저는 Supabase 에 직접 붙지 않고 우리 API 만 부른다.

# 워커 — Notion 자동 등록
# (Google Sheets 는 v1 범위에서 제외했다. README '시트를 빼기로 한 이유' 참고)
NOTION_TOKEN=
NOTION_DATABASE_ID=

# 워커 — 접수 확인 메일 (Gmail SMTP)
# 앱 비밀번호는 2단계 인증을 켠 계정에서 myaccount.google.com/apppasswords 로 발급한다.
# 평소 로그인 비밀번호가 아니다.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# 재처리·삭제 주소 잠금. 아무 긴 문자열이면 된다.
WORKER_SECRET=

# 보관 기간이 지난 사진을 매일 자동 삭제하는 크론용. WORKER_SECRET 과 같은 값을 넣으면 된다.
CRON_SECRET=

# 관리자 화면 잠금. /admin (개설 클래스·신청자) 과 /setup 을 이 비밀번호 하나로 막는다.
# 비어 있으면 /admin 은 아예 열리지 않고, /setup 은 아무나 볼 수 있다.
ADMIN_PASSWORD=

# 성적 관리(/lms) 로그인 쿠키의 서명 열쇠. 아무 긴 문자열이면 된다.
# 비워 두면 ADMIN_PASSWORD 를 대신 쓰므로 새 값 없이도 켜진다.
# 이 값을 바꾸면 나가 있는 로그인이 전부 풀린다 (비밀번호는 그대로다).
LMS_SESSION_SECRET=

# Vercel Analytics 는 대시보드에서 켜기만 하면 되고, 환경변수는 필요 없다.
